<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gunsout.db" />
        <exclude domain="database" path="gunsout.db-shm" />
        <exclude domain="database" path="gunsout.db-wal" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="gunsout.db" />
        <include domain="database" path="gunsout.db-shm" />
        <include domain="database" path="gunsout.db-wal" />
    </device-transfer>
</data-extraction-rules>

