<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The user controls backups via the Settings -> Export JSON workflow. Exclude the Room
         database file from Android auto-cloud-backup so restoring on a new device does not silently
         overwrite the user's choice. The encrypted API-key prefs are also excluded for privacy.
         The DataStore directory is excluded so neither the signed-in identity (auth_session) nor any
         per-user profile (user_prefs_<hash>) ever leaves the device via Auto Backup; data crosses
         devices only via the explicit Settings export. -->
    <exclude domain="database" path="gunsout.db" />
    <exclude domain="database" path="gunsout.db-shm" />
    <exclude domain="database" path="gunsout.db-wal" />
    <exclude domain="sharedpref" path="secure_prefs.xml" />
    <exclude domain="file" path="datastore" />
</full-backup-content>

